# Copy this file to `.env` (gitignored) and fill in your CloudKit API token.
# `make generate` will source .env into the shell so XcodeGen can substitute
# ${CLOUDKIT_API_TOKEN} into project.pbxproj and bake it into Info.plist.
#
# This is the *public* CloudKit API token from CloudKit Dashboard for the
# container iCloud.com.brightdigit.MistDemo — the same value the MistDemo
# CLI reads from $CLOUDKIT_API_TOKEN.
CLOUDKIT_API_TOKEN=
